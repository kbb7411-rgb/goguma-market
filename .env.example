# ── 내 PC에서 개발할 때 (.env.local 로 복사해서 값 채우기) ────────────────
# Supabase 프로젝트 설정 > API 에서 복사

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# 이메일 인증 링크가 되돌아올 주소
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ── Vercel에 배포할 때 ──────────────────────────────────────────────────
# Vercel에서 Supabase 연동(Integration)을 켜면 아래 이름으로 자동으로 들어옵니다.
# lib/env.ts 가 두 가지 이름을 모두 받아주므로, 둘 중 아무거나 하나만 있으면 됩니다.
#
#   NEXT_PUBLIC_SUPABASE_URL              ← 또는 SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  ← 또는 NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_ANON_KEY
#
# 사이트 주소는 Vercel이 VERCEL_PROJECT_PRODUCTION_URL 을 자동으로 넣어주므로
# NEXT_PUBLIC_SITE_URL 은 안 넣어도 됩니다.
#
# ⚠️ Type은 반드시 "Config" (Sensitive 아님 — NEXT_PUBLIC_ 은 브라우저로 나가는 값이라 서로 모순)
# ⚠️ 값을 넣은 뒤 Deployments > Redeploy 에서 "Use existing Build Cache" 를 끄고 다시 빌드해야 반영됩니다.
